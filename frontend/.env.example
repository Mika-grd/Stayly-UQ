# URL publica de Spring Boot, incluida la ruta /api (Guia 22, 6.1).
# Si se omite, la SPA usa /api en el mismo origen (en desarrollo, el proxy de Vite).
VITE_API_URL=https://api.ejemplo.com/api

# Opcional: token publico de Mapbox para el mapa del alojamiento. Sin el se usa OpenStreetMap.
VITE_MAPBOX_TOKEN=
