# Colección de pruebas de la API del SGA · Stayly-UQ (Entrega 2)
#
# Cliente: IntelliJ HTTP Client (botón "Run All Requests in File") o su CLI ijhttp:
#   ijhttp docs/api/coleccion-sga.http
# Se ejecuta completa, en orden, contra la aplicación recién arrancada (cd backend && ./gradlew bootRun),
# sin preparar nada a mano: los tokens, las fechas (relativas a hoy) y los códigos de reserva los guarda
# cada petición para las siguientes. Cada petición verifica su HTTP y, en los errores, su código de negocio.
# Para repetirla, reinicie la aplicación: H2 vuelve a los datos de prueba de la sección 12.3.
#
# Las líneas "# espera:" y "# guarda:" las lee también la prueba ColeccionHttpIntegracionTest, que ejecuta
# este mismo archivo con ./gradlew test. Archivo generado: si cambia una petición, cambie también su espera.

@base = http://localhost:8080

# ============================================================================================================
# 0. Sesiones: un token por rol (7.1, 7.2)
# ============================================================================================================

### 0.1 Login del administrador -> 200 (además fija las fechas relativas a hoy)
# espera: 200
# guarda: tokenAdmin = $.token
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "correo": "admin@stayly.local",
  "contrasena": "Admin2026"
}

> {%
    // Fechas relativas a hoy (hora local del equipo), para que la colección sirva cualquier día
    const fecha = n => {
        const d = new Date();
        d.setDate(d.getDate() + n);
        const dos = x => String(x).padStart(2, "0");
        return d.getFullYear() + "-" + dos(d.getMonth() + 1) + "-" + dos(d.getDate());
    };
    client.global.set("hoy", fecha(0));
    client.global.set("ayer", fecha(-1));
    [1, 2, 4, 10, 11, 12, 13, 15, 40, 42, 60, 61, 63, 64, 70, 72, 80, 83].forEach(n => client.global.set("hoyMas" + n, fecha(n)));
    client.test("0.1 Login del administrador -> 200 (además fija las fechas relativas a hoy)", () => {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
    });
    client.global.set("tokenAdmin", response.body.token);
%}

