  "identificacionApartamento": "SUQ-201",
  "fechaEntrada": "{{hoy}}",
  "fechaSalida": "{{hoyMas2}}",
  "titular": {
    "nombre": "Pedro Gil",
    "documentoIdentidad": "1094000100",
    "fechaNacimiento": "1984-05-02",
    "correo": "pedro.gil@correo.co",
    "telefono": "3004000100"
  }
}

> {%
