### 4.4 Recepción no puede cambiar el alojamiento -> 403 (solo administrador)
# espera: 403 ACCESO_DENEGADO
PUT {{base}}/api/alojamiento
Content-Type: application/json
Authorization: Bearer {{tokenRecepcion}}

{
  "nombre": "Stayly-UQ",
  "descripcion": "Edificio de seis apartamentos independientes y totalmente equipados para visitantes de la universidad, viajeros de negocios y turistas del Eje Cafetero.",
  "ciudad": "Armenia, Quindio",
  "direccion": "Carrera 15 con Calle 12 Norte, sector norte",
  "ubicacion": {
    "latitud": 4.5532,
    "longitud": -75.6593
  },
  "horaEntrada": "15:00",
  "horaSalida": "12:00",
  "normasConvivencia": [
    "Silencio de 22:00 a 7:00",
    "Prohibido fumar dentro de los apartamentos",
    "No se permiten fiestas ni eventos",
    "Solo se permite estar a los ocupantes registrados",
    "Mascotas con correa en las zonas comunes",
    "Separar los residuos para reciclaje"
  ],
  "serviciosAdicionales": [
    {
      "nombre": "Desayuno tipico (por persona por dia)",
      "generaCargo": true,
      "valor": 18000
    },
    {
      "nombre": "Parqueadero (por noche, cupo limitado)",
      "generaCargo": true,
      "valor": 15000
    },
    {
      "nombre": "Lavanderia (por carga)",
      "generaCargo": true,
      "valor": 20000
    },
    {
      "nombre": "Traslado a la terminal o al aeropuerto El Eden (por trayecto)",
      "generaCargo": true,
      "valor": 60000
    }
  ],
  "parametros": {
    "umbralEdadFacturable": 12,
    "tiempoPreparacionHoras": 3,
    "plazoConfirmacionHoras": 24,
    "horaLimiteNoShow": "23:00",
